@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<http://sitar.local/plugins/sitar>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate       <modgui/icon-sitar.html> ;
        modgui:stylesheet         <modgui/stylesheet-sitar.css> ;
        modgui:javascript         <modgui/script-sitar.js> ;
        modgui:screenshot         <modgui/screenshot-sitar.png> ;
        modgui:thumbnail          <modgui/thumbnail-sitar.png> ;

        modgui:brand "sitar" ;
        modgui:label "Sympathetic Sitar" ;
        modgui:model "boxy" ;
        modgui:panel "3-knob" ;
        modgui:color "wood3" ;
        modgui:knob  "gold" ;

        # Per-string frequency ports (string_1..string_48) are intentionally
        # NOT listed here. They still exist as LV2 ports and the DSP keeps
        # them in sync with the current scale/root, but the modgui only
        # surfaces the NUM ACTIVE / OFFSET cursor pair below.
        modgui:port [
            lv2:symbol "num_active" ;
            lv2:name "Active Strings"
        ] , [
            lv2:symbol "string_offset" ;
            lv2:name "String Offset"
        ] , [
            lv2:symbol "decay" ;
            lv2:name "Decay"
        ] , [
            lv2:symbol "mix" ;
            lv2:name "Mix"
        ] , [
            lv2:symbol "jawari" ;
            lv2:name "Jawari"
        ] , [
            lv2:symbol "scale" ;
            lv2:name "Scale"
        ] , [
            lv2:symbol "root_note" ;
            lv2:name "Root Note"
        ] , [
            lv2:symbol "audition" ;
            lv2:name "Test Scale"
        ] , [
            lv2:symbol "bloom" ;
            lv2:name "Bloom"
        ]
    ] .
