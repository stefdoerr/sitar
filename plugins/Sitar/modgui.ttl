@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<http://sitar.local/plugins/sitar>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate       <modgui/icon-sitar.html> ;
        modgui:stylesheet         <modgui/stylesheet-sitar.css> ;
        modgui:javascript         <modgui/script-sitar.js> ;
        modgui:screenshot         <modgui/screenshot-sitar.png> ;
        modgui:thumbnail          <modgui/thumbnail-sitar.png> ;
        # Beginner PDF manual — when declared, mod-ui shows a "documentation"
        # button in the plugin info dialog. The Makefile's modgui target
        # copies docs/manual/sitar-manual.pdf into the bundle under this
        # FIXED name, so renaming the plugin can't break the reference.
        modgui:documentation      <modgui/manual.pdf> ;

        modgui:brand "Stefan" ;
        modgui:label "Sympathetic Sitar" ;
        modgui:model "boxy" ;
        modgui:panel "3-knob" ;
        modgui:color "wood3" ;
        modgui:knob  "gold" ;

        modgui:port [
            lv2:symbol "num_active" ;
            lv2:name "Active Strings"
        ] , [
            lv2:symbol "octave" ;
            lv2:name "Octave"
        ] , [
            lv2:symbol "decay" ;
            lv2:name "Decay"
        ] , [
            lv2:symbol "mix" ;
            lv2:name "Mix"
        ] , [
            lv2:symbol "jawari" ;
            lv2:name "Jawari"
        ] , [
            lv2:symbol "scale" ;
            lv2:name "Scale"
        ] , [
            lv2:symbol "root_note" ;
            lv2:name "Root Note"
        ] , [
            lv2:symbol "audition" ;
            lv2:name "Test Scale"
        ] , [
            lv2:symbol "bloom" ;
            lv2:name "Bloom"
        ] , [
            lv2:symbol "stereo_mode" ;
            lv2:name "Stereo Mode"
        ] , [
            lv2:symbol "gate" ;
            lv2:name "Gate"
        ] , [
            lv2:symbol "level" ;
            lv2:name "Level"
        ] , [
            lv2:symbol "sensitivity" ;
            lv2:name "Sensitivity"
        ]
    ] .
